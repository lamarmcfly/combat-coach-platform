DATABASE_URL="postgresql://corner:corner@localhost:5432/corner_dev?schema=public"
NEXTAUTH_SECRET="replace-with-openssl-output"
NEXTAUTH_URL="http://localhost:3000"

STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

NEXT_PUBLIC_VIDEO_PROVIDER="static"
VIDEO_PROVIDER_BASE_URL="https://videos.corner-placeholder.com"
VIDEO_PROVIDER_TOKEN=""
NEXT_PUBLIC_HERO_VIDEO_FALLBACK="/video/corner-demo.mp4"

MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY=""

# Email Configuration (SendGrid)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@combatcoach.app"

# App URL (used for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar Integration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional feature flags
ALLOW_DUMMY_PAYMENTS="true"

# Sentry Error Tracking (optional but recommended)
# Get your DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Web Push Notifications (optional)
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@combatcoach.app"

# Rate Limiting (Upstash Redis - optional)
# Get your credentials from: https://console.upstash.com/
# Falls back to in-memory rate limiting if not configured
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
