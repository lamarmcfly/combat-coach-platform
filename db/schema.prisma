generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATHLETE
  COACH
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum PurchaseStatus {
  PENDING
  ACTIVE
  REFUNDED
  CANCELED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
}

enum CreditType {
  MONTHLY
  PACK
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    DateTime?
  passwordHash     String
  firstName        String?
  lastName         String?
  role             Role             @default(ATHLETE)
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  coachProfile        CoachProfile?
  coursePurchases     CoursePurchase[]
  liveSessionBookings LiveSessionBooking[]
  subscription        Subscription?
  creditTransactions  CreditTransaction[]
  officeHoursBookings OfficeHoursBooking[]
  trainingSchedules   TrainingSchedule[]
  adherenceStats      AdherenceStats[]
  coachingRequests    CoachingRequest[]    @relation("StudentRequests")
  goals               Goal[]
  trainingLineage     TrainingLineage[]
  beltPromotions      BeltPromotion[]
  weightEntries       WeightEntry[]
  weightGoal          WeightGoal?
  fights              Fight[]
  sparringPreference  SparringPreference?
  sparringRequestsSent     SparringRequest[] @relation("SparringRequester")
  sparringRequestsReceived SparringRequest[] @relation("SparringPartner")
  connectedCalendars  ConnectedCalendar[]
  calendarSubscription CalendarSubscription?
  notificationPreferences NotificationPreferences?
  courseReviews       CourseReview[]
  pushSubscriptions      PushSubscription[]
  badges                 UserBadge[]
  certificates           Certificate[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model CoachProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  displayName       String
  tagline           String?
  gymName           String?
  gymLocation       String?
  shortBio          String?
  longBio           String?
  avatarUrl         String?
  highlightVideoUrl String?
  yearsCoaching     Int?
  location          String?
  socialLinks       Json?
  status            CoachStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  disciplines      CoachDiscipline[]
  courses          Course[]
  liveSessions     LiveSession[]
  payouts          Payout[]
  officeHoursSlots OfficeHoursSlot[]
  coachingRequests CoachingRequest[] @relation("CoachRequests")
  trainedAthletes  TrainingLineage[]
  beltPromotions   BeltPromotion[]   @relation("BeltPromotions")
}

enum CoachStatus {
  PENDING
  APPROVED
  REJECTED
}

model Discipline {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses           Course[]
  liveSessions      LiveSession[]
  coachAssociations CoachDiscipline[]
  trainingSchedules TrainingSchedule[]
  goals             Goal[]
}

model CoachDiscipline {
  coachId      String
  disciplineId Int

  coach      CoachProfile @relation(fields: [coachId], references: [id])
  discipline Discipline   @relation(fields: [disciplineId], references: [id])

  @@id([coachId, disciplineId])
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  shortDescription String
  longDescription  String
  priceCents       Int
  level            CourseLevel  @default(ALL_LEVELS)
  durationMinutes  Int?
  coverImageUrl    String?
  trailerVideoUrl  String?
  featured         Boolean      @default(false)
  status           CourseStatus @default(DRAFT)
  coachId          String
  disciplineId     Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  coach             CoachProfile       @relation(fields: [coachId], references: [id])
  discipline        Discipline         @relation(fields: [disciplineId], references: [id])
  lessons           Lesson[]
  purchases         CoursePurchase[]
  trainingSchedules TrainingSchedule[]
  coachingRequests  CoachingRequest[]
  goals             Goal[]
  reviews           CourseReview[]
  certificates      Certificate[]
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int      // 1-5 stars
  title     String?
  content   String?
  helpful   Int      @default(0) // Count of "helpful" votes
  verified  Boolean  @default(false) // Verified purchase
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId]) // One review per user per course
  @@index([courseId])
  @@index([userId])
}

model Lesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  description     String?
  orderIndex      Int
  durationSeconds Int?
  videoUrl        String
  muxAssetId      String?
  muxPlaybackId   String?
  isPreview       Boolean  @default(false)
  moduleName      String?
  createdAt       DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId, orderIndex])
}

model LiveSession {
  id              String            @id @default(cuid())
  coachId         String
  disciplineId    Int
  title           String
  description     String?
  level           CourseLevel       @default(ALL_LEVELS)
  startTime       DateTime
  durationMinutes Int
  capacity        Int
  priceCents      Int
  meetingUrl      String?
  promoVideoUrl   String?
  status          LiveSessionStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())

  coach      CoachProfile         @relation(fields: [coachId], references: [id])
  discipline Discipline           @relation(fields: [disciplineId], references: [id])
  bookings   LiveSessionBooking[]
}

enum LiveSessionStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELED
}

model CoursePurchase {
  id               String         @id @default(cuid())
  userId           String
  courseId         String
  status           PurchaseStatus @default(PENDING)
  amountCents      Int
  currency         String         @default("usd")
  paymentProvider  String         @default("stripe")
  paymentStatus    String         @default("pending")
  progressPercent  Int            @default(0)
  accessGrantedAt  DateTime?
  stripeCheckoutId String?
  purchasedAt      DateTime       @default(now())
  createdAt        DateTime       @default(now())

  user        User         @relation(fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  certificate Certificate?

  @@unique([userId, courseId])
}

model LiveSessionBooking {
  id               String        @id @default(cuid())
  userId           String
  liveSessionId    String
  status           BookingStatus @default(PENDING)
  amountCents      Int
  currency         String        @default("usd")
  paymentStatus    String        @default("pending")
  stripeCheckoutId String?
  bookedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([userId, liveSessionId])
}

model Payout {
  id                String       @id @default(cuid())
  coachId           String
  amountCents       Int
  currency          String       @default("usd")
  status            PayoutStatus @default(PENDING)
  transferReference String?
  providerPayoutId  String?
  periodStart       DateTime
  periodEnd         DateTime
  payoutDate        DateTime?
  createdAt         DateTime     @default(now())

  coach CoachProfile @relation(fields: [coachId], references: [id])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  tier                   SubscriptionTier
  status                 SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  monthlyCreditsRemaining Int               @default(0)
  monthlyCoursesUsed     Int               @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeSubscriptionId])
  @@index([status])
}

model CreditTransaction {
  id              String     @id @default(cuid())
  userId          String
  type            CreditType
  amount          Int
  balance         Int
  description     String
  creditPackId    String?
  expiresAt       DateTime?
  sessionId       String?
  createdAt       DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditPack CreditPack? @relation(fields: [creditPackId], references: [id])

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model CreditPack {
  id                   String              @id @default(cuid())
  name                 String
  credits              Int
  priceCents           Int
  validityMonths       Int                 @default(6)
  stripePriceId        String?             @unique
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  transactions CreditTransaction[]
}

model OfficeHoursSlot {
  id             String               @id @default(cuid())
  coachId        String
  startTime      DateTime
  endTime        DateTime
  isRecurring    Boolean              @default(false)
  recurringRule  String?
  maxAttendees   Int                  @default(1)
  meetingUrl     String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  coach    CoachProfile         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  bookings OfficeHoursBooking[]

  @@index([coachId, startTime])
}

model OfficeHoursBooking {
  id        String   @id @default(cuid())
  slotId    String
  userId    String
  status    String   @default("confirmed")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slot OfficeHoursSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([userId])
}

// ============================================
// Schedule & Reminders System
// ============================================

enum ScheduleFrequency {
  ONCE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum ReminderType {
  PUSH
  EMAIL
  SMS
}

enum ScheduleStatus {
  ACTIVE
  COMPLETED
  SKIPPED
  CANCELLED
}

model TrainingSchedule {
  id              String            @id @default(cuid())
  userId          String
  title           String
  description     String?
  frequency       ScheduleFrequency @default(WEEKLY)
  startDate       DateTime
  endDate         DateTime?
  daysOfWeek      Int[]             // [0-6] Sunday=0, Monday=1, etc
  timeOfDay       String            // HH:MM format
  durationMinutes Int               @default(60)
  reminderMinutes Int               @default(30) // Remind X minutes before
  isActive        Boolean           @default(true)
  courseId        String?
  disciplineId    Int?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  discipline  Discipline?           @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  occurrences ScheduleOccurrence[]
  reminders   ScheduleReminder[]

  @@index([userId, isActive])
  @@index([startDate, endDate])
}

model ScheduleOccurrence {
  id             String         @id @default(cuid())
  scheduleId     String
  scheduledFor   DateTime
  completedAt    DateTime?
  status         ScheduleStatus @default(ACTIVE)
  durationActual Int? // Actual duration if completed
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  schedule TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, scheduledFor])
  @@index([scheduledFor, status])
}

model ScheduleReminder {
  id          String       @id @default(cuid())
  scheduleId  String
  type        ReminderType @default(PUSH)
  sendAt      DateTime
  sent        Boolean      @default(false)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime     @default(now())

  schedule TrainingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([sendAt, sent])
  @@index([scheduleId])
}

model AdherenceStats {
  id                  String   @id @default(cuid())
  userId              String
  weekStart           DateTime
  weekEnd             DateTime
  scheduledSessions   Int      @default(0)
  completedSessions   Int      @default(0)
  skippedSessions     Int      @default(0)
  adherenceRate       Float    @default(0) // Percentage
  totalMinutesTrained Int      @default(0)
  streak              Int      @default(0) // Current consecutive weeks with >80% adherence
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

// ============================================
// Asynchronous Coaching System
// ============================================

enum CoachingRequestStatus {
  PENDING
  IN_REVIEW
  RESPONDED
  COMPLETED
  ARCHIVED
}

enum CoachingRequestType {
  VIDEO_REVIEW
  TECHNIQUE_CHECK
  FORM_ANALYSIS
  TRAINING_QUESTION
  STRATEGY_ADVICE
  GENERAL
}

enum CoachingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AttachmentType {
  VIDEO
  IMAGE
  DOCUMENT
  AUDIO
}

model CoachingRequest {
  id          String                @id @default(cuid())
  userId      String                // Student
  coachId     String                // Assigned coach
  status      CoachingRequestStatus @default(PENDING)
  type        CoachingRequestType   @default(GENERAL)
  priority    CoachingPriority      @default(NORMAL)
  title       String
  description String
  tags        String[]              // For categorization/search
  courseId    String?               // Optional: related course
  lessonId    String?               // Optional: related lesson

  // Timestamps
  submittedAt DateTime              @default(now())
  reviewedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user        User                  @relation("StudentRequests", fields: [userId], references: [id], onDelete: Cascade)
  coach       CoachProfile          @relation("CoachRequests", fields: [coachId], references: [id])
  course      Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages    CoachingMessage[]
  attachments CoachingAttachment[]

  @@index([userId, status])
  @@index([coachId, status])
  @@index([submittedAt])
  @@index([status, priority])
}

model CoachingMessage {
  id              String   @id @default(cuid())
  requestId       String
  senderId        String
  content         String
  isCoachResponse Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  request     CoachingRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attachments CoachingAttachment[]

  @@index([requestId, createdAt])
}

model CoachingAttachment {
  id         String         @id @default(cuid())
  requestId  String?
  messageId  String?
  uploaderId String
  type       AttachmentType
  url        String
  filename   String
  fileSize   Int            // Bytes
  mimeType   String?
  duration   Int?           // For video/audio in seconds
  createdAt  DateTime       @default(now())

  request CoachingRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message CoachingMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([messageId])
}

// ============================================
// Goal-based Personalization System
// ============================================

enum GoalType {
  TECHNIQUE_MASTERY
  COMPETITION_PREP
  FITNESS_IMPROVEMENT
  WEIGHT_CLASS
  BELT_PROMOTION
  SKILL_DEVELOPMENT
  SPARRING_PERFORMANCE
  CUSTOM
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  ABANDONED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum RecommendationType {
  COURSE
  LIVE_SESSION
  TRAINING_SCHEDULE
  TECHNIQUE_FOCUS
  COACH_CONSULTATION
  REST_DAY
}

model Goal {
  id              String     @id @default(cuid())
  userId          String
  type            GoalType
  status          GoalStatus @default(NOT_STARTED)
  title           String
  description     String?
  targetDate      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  progressPercent Int        @default(0)

  // Goal specifics
  targetValue     Float?     // e.g., weight, reps, time
  currentValue    Float?
  unit            String?    // e.g., "lbs", "minutes", "repetitions"

  // Related entities
  disciplineId    Int?
  courseId        String?

  // Metadata
  isPublic        Boolean    @default(false)
  tags            String[]
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline     Discipline?       @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  course         Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  milestones     GoalMilestone[]
  progressLogs   GoalProgressLog[]
  recommendations Recommendation[]

  @@index([userId, status])
  @@index([targetDate])
  @@index([type, status])
}

model GoalMilestone {
  id          String          @id @default(cuid())
  goalId      String
  title       String
  description String?
  status      MilestoneStatus @default(PENDING)
  orderIndex  Int
  targetDate  DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, orderIndex])
  @@index([goalId, status])
}

model GoalProgressLog {
  id          String   @id @default(cuid())
  goalId      String
  logDate     DateTime @default(now())
  value       Float?   // Current measurement
  notes       String?
  mood        Int?     // 1-5 scale
  difficulty  Int?     // 1-5 scale
  attachments Json?    // URLs to photos/videos
  createdAt   DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, logDate])
}

model Recommendation {
  id             String             @id @default(cuid())
  userId         String
  goalId         String?
  type           RecommendationType
  title          String
  description    String
  reason         String? // Why this is recommended
  priority       Int                @default(50) // 0-100
  isActive       Boolean            @default(true)
  isDismissed    Boolean            @default(false)
  isCompleted    Boolean            @default(false)

  // Related entities
  courseId       String?
  liveSessionId  String?
  scheduleId     String?

  // Metadata
  validUntil     DateTime?
  createdAt      DateTime           @default(now())
  dismissedAt    DateTime?
  completedAt    DateTime?

  goal Goal? @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, isDismissed])
  @@index([goalId])
  @@index([priority, createdAt])
}

// ============================================
// Training Lineage System
// ============================================

model TrainingLineage {
  id              String   @id @default(cuid())
  userId          String
  coachName       String   // Name of the coach (may not be on platform)
  coachProfileId  String?  // If coach is on platform
  gymName         String?
  location        String?
  discipline      String   // e.g., "Boxing", "BJJ", "Muay Thai"
  startYear       Int?
  endYear         Int?     // Null if still training
  beltOrRank      String?  // e.g., "Black Belt", "Professional"
  isVerified      Boolean  @default(false)
  notes           String?
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachProfile CoachProfile? @relation(fields: [coachProfileId], references: [id], onDelete: SetNull)

  @@index([userId, orderIndex])
  @@index([coachProfileId])
}

// ============================================
// Belt/Rank Progression System
// ============================================

enum BeltColor {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
  RED_BLACK
  RED_WHITE
  RED
  // Additional for other arts
  YELLOW
  ORANGE
  GREEN
  CORAL
}

model BeltPromotion {
  id           String     @id @default(cuid())
  userId       String
  discipline   String     // e.g., "BJJ", "Judo", "Karate"
  beltColor    BeltColor
  stripes      Int        @default(0)  // 0-4 stripes for BJJ
  degree       Int?       // For black belts (1st degree, 2nd, etc.)
  promotedAt   DateTime
  promotedBy   String?    // Name of instructor
  coachId      String?    // If promoter is on platform
  gymName      String?
  certificateUrl String?
  isVerified   Boolean    @default(false)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach CoachProfile? @relation("BeltPromotions", fields: [coachId], references: [id], onDelete: SetNull)

  @@index([userId, discipline, promotedAt])
  @@index([coachId])
}

// ============================================
// Weight Management System
// ============================================

enum WeightUnit {
  LBS
  KG
}

model WeightEntry {
  id          String     @id @default(cuid())
  userId      String
  weight      Float      // Weight value
  unit        WeightUnit @default(LBS)
  loggedAt    DateTime   @default(now())
  notes       String?
  isFightWeight Boolean  @default(false)  // Was this for a weigh-in?
  eventName   String?    // If fight weight, what event
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model WeightGoal {
  id              String     @id @default(cuid())
  userId          String     @unique
  targetWeight    Float
  unit            WeightUnit @default(LBS)
  targetDate      DateTime?
  weightClass     String?    // e.g., "Lightweight 155", "Welterweight 170"
  currentWeight   Float?
  startWeight     Float?
  startDate       DateTime   @default(now())
  isActive        Boolean    @default(true)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Fight Analysis System
// ============================================

enum FightType {
  COMPETITION
  SPARRING
  TRAINING
  EXHIBITION
}

enum FightResult {
  WIN
  LOSS
  DRAW
  NO_CONTEST
  IN_PROGRESS
}

enum FinishType {
  DECISION_UNANIMOUS
  DECISION_SPLIT
  DECISION_MAJORITY
  KO
  TKO
  SUBMISSION
  DQ
  TECHNICAL_DECISION
  NONE
}

model Fight {
  id              String       @id @default(cuid())
  userId          String
  type            FightType    @default(SPARRING)
  result          FightResult  @default(IN_PROGRESS)
  finishType      FinishType   @default(NONE)
  finishRound     Int?         // Round in which fight ended
  finishTime      String?      // Time in round (e.g., "2:34")

  // Event details
  eventName       String?
  eventDate       DateTime
  location        String?
  weightClass     String?

  // Opponent info
  opponentName    String?
  opponentRecord  String?      // e.g., "5-2-0"
  opponentNotes   String?

  // Video reference
  videoUrl        String?
  thumbnailUrl    String?

  // Summary stats
  totalRounds     Int          @default(3)
  roundMinutes    Int          @default(5)

  // Tags for filtering
  discipline      String?      // e.g., "MMA", "Boxing", "BJJ"
  tags            String[]

  // Notes
  gameplanNotes   String?      // Pre-fight game plan
  summaryNotes    String?      // Post-fight summary
  lessonsLearned  String?      // Key takeaways

  isPublic        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds     FightRound[]
  techniques FightTechnique[]

  @@index([userId, eventDate])
  @@index([result])
  @@index([type])
}

model FightRound {
  id              String   @id @default(cuid())
  fightId         String
  roundNumber     Int

  // Striking stats
  strikesLanded   Int      @default(0)
  strikesAttempted Int     @default(0)
  sigStrikesLanded Int     @default(0)
  sigStrikesAttempted Int  @default(0)
  knockdowns      Int      @default(0)

  // Grappling stats
  takedownsLanded Int      @default(0)
  takedownsAttempted Int   @default(0)
  submissionAttempts Int   @default(0)
  sweeps          Int      @default(0)
  reversals       Int      @default(0)

  // Control time (in seconds)
  controlTimeTop  Int      @default(0)
  controlTimeBack Int      @default(0)
  controlTimeClinch Int    @default(0)
  timeInGuard     Int      @default(0)

  // Defense
  strikesAbsorbed Int      @default(0)
  takedownsDefended Int    @default(0)
  submissionsDefended Int  @default(0)

  // Round outcome
  roundWinner     String?  // "self", "opponent", "even"
  notes           String?
  keyMoments      String?  // Timestamps of important moments

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fight Fight @relation(fields: [fightId], references: [id], onDelete: Cascade)

  @@unique([fightId, roundNumber])
  @@index([fightId])
}

model FightTechnique {
  id              String   @id @default(cuid())
  fightId         String
  roundNumber     Int?     // Null if general observation

  // Technique details
  techniqueName   String   // e.g., "Rear Naked Choke", "Jab", "Double Leg"
  category        String   // e.g., "Strikes", "Takedowns", "Submissions", "Sweeps"

  // Performance
  attempted       Int      @default(0)
  successful      Int      @default(0)

  // Timestamp reference (if video available)
  timestamp       String?  // e.g., "R2 3:45"

  // Notes
  notes           String?
  wasEffective    Boolean  @default(true)
  needsWork       Boolean  @default(false)

  createdAt       DateTime @default(now())

  fight Fight @relation(fields: [fightId], references: [id], onDelete: Cascade)

  @@index([fightId])
  @@index([techniqueName])
}

// ============================================
// Sparring Partner Matching System
// ============================================

enum SparringRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  COMPLETED
}

model SparringPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  isAvailable   Boolean  @default(true)
  weightClass   String?  // e.g., "Lightweight 155", "Welterweight 170"
  disciplines   String[] // e.g., ["MMA", "Boxing", "BJJ"]
  location      String?  // City/region
  latitude      Float?   // For distance calculations
  longitude     Float?
  radius        Int      @default(25)  // Search radius in miles
  experienceMin Int?     // Minimum years of experience
  experienceMax Int?     // Maximum years of experience
  skillLevel    String?  // e.g., "Beginner", "Intermediate", "Advanced", "Pro"
  preferredDays String[] // e.g., ["Monday", "Wednesday", "Saturday"]
  preferredTime String?  // e.g., "Morning", "Afternoon", "Evening"
  gymName       String?
  notes         String?  // Additional info for potential partners
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable, weightClass])
  @@index([location])
}

model SparringRequest {
  id            String                @id @default(cuid())
  requesterId   String                // User sending the request
  partnerId     String                // User receiving the request
  status        SparringRequestStatus @default(PENDING)

  // Proposed session details
  proposedDate  DateTime?
  proposedTime  String?               // e.g., "14:00"
  location      String?
  discipline    String?               // e.g., "MMA", "Boxing"
  intensity     String?               // e.g., "Light", "Medium", "Hard"
  duration      Int?                  // Duration in minutes

  // Messages
  message       String?               // Initial request message
  responseNote  String?               // Response from partner

  // Timestamps
  respondedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  requester User @relation("SparringRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  partner   User @relation("SparringPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([partnerId, status])
  @@index([proposedDate])
}

// ============================================
// Connected Calendars (Google, Apple, etc.)
// ============================================

enum CalendarProvider {
  GOOGLE
  APPLE
  OUTLOOK
}

model ConnectedCalendar {
  id              String           @id @default(cuid())
  userId          String
  provider        CalendarProvider
  email           String?          // Calendar account email
  accessToken     String           // Encrypted access token
  refreshToken    String?          // Encrypted refresh token
  tokenExpiry     DateTime?
  calendarId      String?          // Selected calendar ID for syncing
  calendarName    String?          // Display name of the calendar
  isActive        Boolean          @default(true)
  lastSyncAt      DateTime?
  syncErrors      Int              @default(0)
  lastSyncError   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, isActive])
}

// Calendar subscription for external calendar apps (Apple, Outlook, etc.)
model CalendarSubscription {
  id             String    @id @default(cuid())
  userId         String    @unique
  token          String    @unique // Unique token for subscription URL
  isActive       Boolean   @default(true)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User notification preferences
model NotificationPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Email notifications
  emailCoaching         Boolean  @default(true)  // Coaching request updates
  emailSessions         Boolean  @default(true)  // Live session reminders
  emailGoals            Boolean  @default(true)  // Goal progress reminders
  emailSparring         Boolean  @default(true)  // Sparring request updates
  emailBilling          Boolean  @default(true)  // Billing and subscription updates
  emailMarketing        Boolean  @default(false) // Product updates and marketing

  // Push notifications (for future use)
  pushEnabled           Boolean  @default(false)
  pushSessionReminders  Boolean  @default(true)
  pushMessages          Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Push notification subscriptions for Web Push API
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String   @unique
  p256dh      String   // Public key for encryption
  auth        String   // Auth secret
  userAgent   String?  // Browser/device info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// Gamification - Badges & Achievements
// ============================================

enum BadgeCategory {
  STREAK           // Training streak achievements
  COURSES          // Course completion achievements
  SESSIONS         // Live session achievements
  COMMUNITY        // Community engagement achievements
  GOALS            // Goal achievement badges
  SPECIAL          // Special/limited edition badges
}

enum BadgeRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model Badge {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  iconUrl     String?
  category    BadgeCategory
  rarity      BadgeRarity   @default(COMMON)
  points      Int           @default(10) // Points awarded for earning this badge
  requirement String?       // Human-readable requirement description
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userBadges  UserBadge[]

  @@index([category])
  @@index([isActive])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  progress  Int?     // Optional progress tracking (0-100)
  metadata  Json?    // Additional context about how badge was earned

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ============================================
// Course Completion Certificates
// ============================================

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  coursePurchaseId  String   @unique

  // Certificate details
  certificateNumber String   @unique // Unique certificate ID for verification
  recipientName     String            // Name as displayed on certificate
  courseName        String            // Snapshot of course name at time of completion
  coachName         String            // Snapshot of coach name
  completionDate    DateTime

  // Certificate customization
  templateId        String?  // Optional custom template
  signature         String?  // Coach signature URL

  // Verification
  verificationUrl   String   @unique  // Public URL for verification
  isRevoked         Boolean  @default(false)
  revokedAt         DateTime?
  revokedReason     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id])
  coursePurchase CoursePurchase @relation(fields: [coursePurchaseId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([certificateNumber])
}

// ============================================
// Password Reset Tokens
// ============================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================
// Admin Content Management System (CMS)
// ============================================

enum ContentType {
  TEXT
  RICH_TEXT
  IMAGE
  VIDEO
  GALLERY
  LINK
  HTML
  JSON
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Content Sections - Define areas of the site that can be edited
model ContentSection {
  id          String   @id @default(cuid())
  slug        String   @unique  // e.g., "hero-banner", "about-section", "feature-videos"
  name        String            // Display name for admin
  description String?           // Help text for editors
  page        String            // Which page this belongs to (e.g., "home", "about", "pricing")
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contents SiteContent[]

  @@index([page, orderIndex])
  @@index([slug])
}

// Site Content - Individual content items that can be edited
model SiteContent {
  id          String        @id @default(cuid())
  sectionId   String
  key         String        // Unique key within section (e.g., "headline", "background-image")
  type        ContentType   @default(TEXT)
  status      ContentStatus @default(PUBLISHED)

  // Content values (use appropriate field based on type)
  textValue   String?       // For TEXT type
  richText    String?       // For RICH_TEXT type (HTML/Markdown)
  mediaUrl    String?       // For IMAGE, VIDEO types
  mediaAlt    String?       // Alt text for images
  linkUrl     String?       // For LINK type
  linkText    String?       // Display text for links
  jsonValue   Json?         // For complex structured data

  // Metadata
  label       String?       // Display label for admin
  helpText    String?       // Help text for editors
  placeholder String?       // Placeholder value (shown if empty)
  isRequired  Boolean       @default(false)
  orderIndex  Int           @default(0)

  // Version history
  version     Int           @default(1)
  publishedAt DateTime?
  publishedBy String?       // Admin user ID who published

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  section     ContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  history     ContentHistory[]
  media       MediaAsset?

  @@unique([sectionId, key])
  @@index([sectionId, orderIndex])
  @@index([status])
}

// Content History - Track changes for audit/rollback
model ContentHistory {
  id          String      @id @default(cuid())
  contentId   String
  version     Int
  textValue   String?
  richText    String?
  mediaUrl    String?
  jsonValue   Json?
  changedBy   String      // Admin user ID
  changeNote  String?     // Optional note about the change
  createdAt   DateTime    @default(now())

  content     SiteContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, version])
}

// Media Assets - Centralized media library
model MediaAsset {
  id            String    @id @default(cuid())
  contentId     String?   @unique // Optional link to specific content
  filename      String
  originalName  String
  mimeType      String
  size          Int       // File size in bytes
  url           String    // Storage URL
  thumbnailUrl  String?   // For images/videos
  width         Int?      // Image/video width
  height        Int?      // Image/video height
  duration      Int?      // Video duration in seconds
  alt           String?   // Alt text
  caption       String?
  tags          String[]  // For organization/search
  muxAssetId    String?
  muxPlaybackId String?
  uploadedBy    String    // Admin user ID
  folder        String    @default("general") // Organization folder
  isPublic      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  content       SiteContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([folder])
  @@index([uploadedBy])
  @@index([mimeType])
}

// Platform Settings - Global configuration
model PlatformSettings {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String
  type          String    @default("string") // string, number, boolean, json
  category      String    @default("general") // general, branding, features, etc.
  label         String?   // Display label for admin
  description   String?   // Help text
  isPublic      Boolean   @default(false) // Whether visible to non-admins
  updatedBy     String?   // Last admin to update
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
}

// ============================================
// Real-Time Chat System
// ============================================

enum ConversationType {
  DIRECT           // 1-on-1 between users
  COACHING         // Athlete-coach conversation
  GROUP            // Group chat (for future)
  SUPPORT          // Support ticket conversation
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id           String           @id @default(cuid())
  type         ConversationType @default(DIRECT)
  title        String?          // For group chats
  isArchived   Boolean          @default(false)
  lastMessageAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id               String    @id @default(cuid())
  conversationId   String
  userId           String
  lastReadAt       DateTime?
  isMuted          Boolean   @default(false)
  isAdmin          Boolean   @default(false) // For group chats
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  senderId        String        // User who sent the message
  content         String
  status          MessageStatus @default(SENT)
  isEdited        Boolean       @default(false)
  editedAt        DateTime?
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  replyToId       String?       // For threading/replies
  attachments     Json?         // Array of attachment URLs
  metadata        Json?         // Additional data (reactions, etc.)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

// For real-time presence
model UserPresence {
  id           String    @id @default(cuid())
  userId       String    @unique
  isOnline     Boolean   @default(false)
  lastSeenAt   DateTime  @default(now())
  currentPage  String?   // What page they're currently viewing

  @@index([isOnline])
  @@index([lastSeenAt])
}

// ============================================
// Social Features - Follows & Activity Feed
// ============================================

model Follow {
  id          String   @id @default(cuid())
  followerId  String   // User who is following
  followingId String   // User being followed
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum ActivityType {
  COURSE_COMPLETED     // User completed a course
  BADGE_EARNED         // User earned a badge
  GOAL_ACHIEVED        // User achieved a goal
  FIGHT_LOGGED         // User logged a fight
  REVIEW_POSTED        // User posted a review
  STARTED_FOLLOWING    // User followed someone
  COURSE_ENROLLED      // User enrolled in a course
  SESSION_ATTENDED     // User attended a live session
  STREAK_MILESTONE     // User hit a streak milestone (7, 30, 100 days)
}

model ActivityFeedItem {
  id           String       @id @default(cuid())
  userId       String       // User who performed the action
  type         ActivityType
  isPublic     Boolean      @default(true)

  // Context data
  title        String       // Display title
  description  String?      // Optional description
  imageUrl     String?      // Optional image
  linkUrl      String?      // Link to related content

  // Related entities (optional, for rich context)
  courseId     String?
  badgeId      String?
  goalId       String?
  fightId      String?
  targetUserId String?      // For follows

  // Engagement
  likesCount   Int          @default(0)
  commentsCount Int         @default(0)

  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
  @@index([type])
}

model ActivityLike {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model ActivityComment {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  content    String
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([activityId, createdAt])
  @@index([userId])
}

// --- Production Readiness Models ---

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([eventId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceId])
}
